{% set plannedTask = resource %}

<div class="card">
<div class="table-responsive">
<table class="table table-vcenter card-table">
<tbody>
<tr>
    <td class="w-25 text-muted">{{ 'bout_de_code_sylius_etl_plugin.grid.workflow'|trans }}</td>
    <td><a href="{{ path('bout_de_code_sylius_etl_plugin_admin_workflow_show', { id: plannedTask.workflow.id }) }}">{{ plannedTask.workflow.name }}</a></td>
</tr>
<tr>
    <td class="w-25 text-muted">{{ 'bout_de_code_sylius_etl_plugin.grid.created_at'|trans }}</td>
    <td>{{ plannedTask.createdAt|date }}</td>
</tr>
<tr>
    <td class="w-25 text-muted">{{ 'bout_de_code_sylius_etl_plugin.grid.schedule'|trans }}</td>
    <td>{{ plannedTask.schedule }}</td>
</tr>
</tbody>
</table>
</div>
</div>

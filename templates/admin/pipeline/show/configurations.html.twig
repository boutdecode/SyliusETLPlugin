{% set pipeline = hookable_metadata.context.resource %}

<div class="container-xl mb-3">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.pipeline_configuration'|trans }}</h3>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    {% include '@BoutDeCodeSyliusETLPlugin/admin/pipeline/show/_accordion.html.twig' with { title: 'bout_de_code_sylius_etl_plugin.ui.workflow_configuration'|trans, value: pipeline.workflow.stepConfiguration } only %}
                </div>
                <div class="col-md-6">
                    {% include '@BoutDeCodeSyliusETLPlugin/admin/pipeline/show/_accordion.html.twig' with { title: 'bout_de_code_sylius_etl_plugin.ui.override_configuration'|trans, value: pipeline.configuration } only %}
                </div>
            </div>
        </div>
    </div>
</div>

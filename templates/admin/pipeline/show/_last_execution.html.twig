{% set pipeline = resource %}
{% set lastHistory = pipeline.histories|first %}

{% if lastHistory %}
<section class="ui segment">
    <h2 class="ui header">{{ 'bout_de_code_sylius_etl_plugin.ui.last_execution'|trans }}</h2>

    {% include '@BoutDeCodeSyliusETLPlugin/admin/grid/field/status.html.twig' with { data: lastHistory.status } %}
    <span style="margin-left: 0.5rem;">{{ lastHistory.createdAt|date }}</span>

    <div class="ui styled fluid accordion" style="margin-top: 1rem;">
        {% if lastHistory.result %}
        <div class="title">
            <i class="dropdown icon"></i>
            {{ 'bout_de_code_sylius_etl_plugin.ui.result'|trans }}
        </div>
        <div class="content">
            <pre>{{ lastHistory.result|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        </div>
        {% endif %}

        {% set failedStep = lastHistory.stepHistories|filter(s => s.status.value == 'failed')|first %}
        {% if failedStep %}
        <div class="title">
            <i class="dropdown icon"></i>
            {{ 'bout_de_code_sylius_etl_plugin.ui.error'|trans }}
        </div>
        <div class="content">
            <pre>{{ failedStep.result|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        </div>
        {% endif %}
    </div>
</section>
{% endif %}

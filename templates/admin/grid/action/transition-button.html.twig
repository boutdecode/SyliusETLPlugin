{% if options.link.url is defined %}
    {% set path = options.link.url %}
{% else %}
    {% set default_route = options.link.route|default(null) %}
    {% set path = default_route ? path(default_route, options.link.parameters|default({'id': data.id})) : null %}
{% endif %}

{% set message = action.label|default('sylius.ui.show') %}

<form action="{{ path }}" method="post">
    <input type="hidden" name="_method" value="PUT">
    <button type="submit" class="btn {{ options.class|default('') }}" {% if path is empty %}disabled{% endif %} {{ sylius_test_html_attribute('execute-action', message|trans) }}>
        {{ ux_icon('tabler:player-play') }}
        {{ message|trans }}
    </button>
</form>

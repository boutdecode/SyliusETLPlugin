{% set status_value = data.value ?? data %}
{% set status_classes = {
    'pending': 'bg-secondary-lt',
    'scheduled': 'bg-azure-lt',
    'in_progress': 'bg-blue-lt',
    'completed': 'bg-green-lt',
    'failed': 'bg-red-lt'
} %}

<span class="badge {{ status_classes[status_value] ?? 'bg-secondary-lt' }}">
    {{ ('bout_de_code_sylius_etl_plugin.pipeline.status.' ~ status_value)|trans }}
</span>

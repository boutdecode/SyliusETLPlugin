{% extends '@BoutDeCodeSyliusETLPlugin/admin/layout.html.twig' %}

{% set page_title = 'bout_de_code_sylius_etl_plugin.ui.dashboard' %}
{% set page_icon = 'tabler:dashboard' %}
{% set page_subtitle = 'bout_de_code_sylius_etl_plugin.ui.dashboard_subtitle' %}

{% block content %}
{% set totalCount = totalSuccess + totalFailure %}

<div class="d-flex flex-column gap-3">
    <div class="card stats">
        <div class="card-header">
            <h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_summary'|trans }}</h3>
            <div class="card-actions btn-group">
                <button type="button" class="btn btn-sm" data-period="2weeks">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_2weeks'|trans }}</button>
                <button type="button" class="btn btn-sm" data-period="month">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_month'|trans }}</button>
                <button type="button" class="btn btn-sm active" data-period="year">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_year'|trans }}</button>
            </div>
        </div>
        <div class="card-body">
            <div class="row row-cards mb-4">
                    <div class="col-6 col-md-3">
                        <div class="text-center">
                            <div id="stat-total" class="h1 mb-0 ">{{ totalCount }}</div>
                            <div class="text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_total'|trans }}</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center">
                            <div id="stat-success" class="h1 mb-0 text-green">{{ totalSuccess }}</div>
                            <div class="text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_success'|trans }}</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center">
                            <div id="stat-failure" class="h1 mb-0 text-red">{{ totalFailure }}</div>
                            <div class="text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_failure'|trans }}</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center">
                            <div id="stat-rate" class="h1 mb-0 ">{{ totalCount > 0 ? ((totalSuccess / totalCount) * 100)|round(1) : 0 }}%</div>
                            <div class="text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_success_rate'|trans }}</div>
                        </div>
                    </div>
            </div>
            <div class="stats-graph" style="height: 300px;">
                <canvas id="barChart"></canvas>
            </div>
        </div>
    </div>

    {% if byWorkflow|length > 0 %}
    <div class="card">
        <div class="card-header"><h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_duration_workflow'|trans }}</h3></div>
        <div class="card-body">
            <div class="row row-cards mb-4">
                <div class="col-12 col-md-4">
                    <div class="text-center">
                        <div class="h2 mb-0">{{ avgDuration is not null ? avgDuration ~ ' s' : '-' }}</div>
                        <div class="text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_time'|trans }}</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="text-center">
                        <div class="h2 mb-0">{{ minDuration is not null ? minDuration ~ ' s' : '-' }}</div>
                        <div class="text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_min_time'|trans }}</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="text-center">
                        <div class="h2 mb-0">{{ maxDuration is not null ? maxDuration ~ ' s' : '-' }}</div>
                        <div class="text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_max_time'|trans }}</div>
                    </div>
                </div>
            </div>
            <div style="height: 280px;">
                <canvas id="durationChart"></canvas>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="row row-cards">
        <div class="col-12 col-md-4">
            <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_workflow_index') }}" class="btn btn-lg w-100">
                {{ ux_icon('tabler:arrows-split') }}
                {{ 'bout_de_code_sylius_etl_plugin.ui.workflows'|trans }}
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_pipeline_index') }}" class="btn btn-lg w-100">
                {{ ux_icon('tabler:layout-list') }}
                {{ 'bout_de_code_sylius_etl_plugin.ui.pipelines'|trans }}
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_planned_task_index') }}" class="btn btn-lg w-100">
                {{ ux_icon('tabler:history') }}
                {{ 'bout_de_code_sylius_etl_plugin.ui.planned_tasks'|trans }}
            </a>
        </div>
    </div>

    <div class="row row-cards">
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.latest_workflows'|trans }}</h3></div>
                {% if latestWorkflows|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.name'|trans }}</th>
                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.created_at'|trans }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for workflow in latestWorkflows %}
                            <tr>
                                <td><strong>{{ workflow.name }}</strong></td>
                                <td class="text-muted">{{ workflow.createdAt|date('d/m/Y') }}</td>
                                <td class="text-end">
                                    <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_workflow_show', {'id': workflow.id}) }}" class="btn btn-sm">
                                        {{ ux_icon('tabler:eye') }}
                                        {{ 'bout_de_code_sylius_etl_plugin.action.show'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="card-body text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.no_results'|trans }}</div>
                {% endif %}
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.latest_planned_tasks'|trans }}</h3></div>
                {% if latestPlannedTasks|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.name'|trans }}</th>
                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.enabled'|trans }}</th>
                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.created_at'|trans }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for task in latestPlannedTasks %}
                            <tr>
                                <td><strong>{{ task.name }}</strong></td>
                                <td>{% include '@BoutDeCodeSyliusETLPlugin/admin/grid/field/enabled.html.twig' with { data: task.enabled } %}</td>
                                <td class="text-muted">{{ task.createdAt|date('d/m/Y') }}</td>
                                <td class="text-end">
                                    <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_planned_task_show', {'id': task.id}) }}" class="btn btn-sm">
                                        {{ ux_icon('tabler:eye') }}
                                        {{ 'bout_de_code_sylius_etl_plugin.action.show'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="card-body text-muted">{{ 'bout_de_code_sylius_etl_plugin.ui.no_results'|trans }}</div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
    const successColor = '#21ba45';
    const failureColor = '#db2828';
    const durationColor = '#2185d0';
    const labelCompleted = {{ 'bout_de_code_sylius_etl_plugin.pipeline.status.completed'|trans|json_encode|raw }};
    const labelFailed = {{ 'bout_de_code_sylius_etl_plugin.pipeline.status.failed'|trans|json_encode|raw }};
    const labelAvgDuration = {{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_duration_workflow'|trans|json_encode|raw }};

    const allHistories = {{ historiesPerDay|json_encode|raw }};
    const periodDays = { '2weeks': 14, 'month': 30, 'year': 365 };

    function cutoffDate(days) {
        const d = new Date();
        d.setDate(d.getDate() - days);
        return d.toISOString().slice(0, 10);
    }

    function filterHistories(days) {
        if (!days) return allHistories;
        const cutoff = cutoffDate(days);
        return allHistories.filter(r => r.day >= cutoff);
    }

    function buildDayData(histories) {
        const days = [...new Set(histories.map(r => r.day))].sort();
        return {
            labels: days,
            success: days.map(d => histories.filter(r => r.day === d && r.status === 'completed').reduce((s, r) => s + r.count, 0)),
            failure: days.map(d => histories.filter(r => r.day === d && r.status === 'failed').reduce((s, r) => s + r.count, 0)),
        };
    }

    // --- Avg duration per workflow (global, PipelineStatistic aggregated by workflow) ---
    const allWorkflows = {{ byWorkflow|json_encode|raw }};
    const durationCtx = document.getElementById('durationChart');
    if (durationCtx) {
        new Chart(durationCtx, {
            type: 'bar',
            data: {
                labels: allWorkflows.map(w => w.name),
                datasets: [{
                    label: labelAvgDuration,
                    data: allWorkflows.map(w => w.avgDuration),
                    backgroundColor: durationColor + 'bb',
                    borderColor: durationColor,
                    borderWidth: 1,
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, title: { display: true, text: 's' } } },
            },
        });
    }

    // --- Vertical stacked bar by day (period-filtered) ---
    const barCtx = document.getElementById('barChart');
    let barChart = null;
    if (barCtx) {
        const initial = buildDayData(filterHistories(periodDays['year']));
        barChart = new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: initial.labels,
                datasets: [
                    { label: labelCompleted, data: initial.success, backgroundColor: successColor },
                    { label: labelFailed, data: initial.failure, backgroundColor: failureColor },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                scales: {
                    x: { stacked: false },
                    y: { beginAtZero: true, stacked: false },
                },
            },
        });
    }

    function updateChart(days) {
        if (!barChart) return;
        const data = buildDayData(filterHistories(days));
        barChart.data.labels = data.labels;
        barChart.data.datasets[0].data = data.success;
        barChart.data.datasets[1].data = data.failure;
        barChart.update();
    }

    document.querySelectorAll('[data-period]').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('[data-period]').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            updateChart(periodDays[this.dataset.period]);
        });
    });

    // Initialize with year filter
    updateChart(periodDays['year']);
})();
</script>
{% endblock %}

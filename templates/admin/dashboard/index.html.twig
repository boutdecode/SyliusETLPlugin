{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% import '@SyliusAdmin/shared/helper/header.html.twig' as header %}

{% block title %}{{ 'bout_de_code_sylius_etl_plugin.ui.dashboard'|trans }} {{ parent() }}{% endblock %}

{% block body %}
    {% hook 'bout_de_code_sylius_etl_plugin.dashboard' %}

    {% set totalCount = totalSuccess + totalFailure %}

    <div class="page-wrapper">
        <div class="page-header">
            <div class="container-xl">
                <div class="row mt-3">
                    <div class="col-12">
                        {{ header.h1('bout_de_code_sylius_etl_plugin.ui.dashboard'|trans, 'tabler:chart-bar', 'bout_de_code_sylius_etl_plugin.ui.dashboard_subtitle'|trans) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                <div class="row row-cards">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_summary'|trans }}</h3>
                                <div class="card-actions btn-group">
                                    <button type="button" class="btn btn-sm" data-period="2weeks">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_2weeks'|trans }}</button>
                                    <button type="button" class="btn btn-sm" data-period="month">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_month'|trans }}</button>
                                    <button type="button" class="btn btn-sm active" data-period="year">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_year'|trans }}</button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row text-center mb-3">
                                    <div class="col-6 col-md-3">
                                        <div class="h1 mb-0" id="stat-total">{{ totalCount }}</div>
                                        <div class="text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_total'|trans }}</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="h1 mb-0 text-green" id="stat-success">{{ totalSuccess }}</div>
                                        <div class="text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_success'|trans }}</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="h1 mb-0 text-red" id="stat-failure">{{ totalFailure }}</div>
                                        <div class="text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_failure'|trans }}</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="h1 mb-0" id="stat-rate">{{ totalCount > 0 ? ((totalSuccess / totalCount) * 100)|round(1) : 0 }}%</div>
                                        <div class="text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_success_rate'|trans }}</div>
                                    </div>
                                </div>
                                <div style="height: 300px;"><canvas id="barChart"></canvas></div>
                            </div>
                        </div>
                    </div>

                    {% if byWorkflow|length > 0 %}
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_duration_workflow'|trans }}</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row text-center mb-3">
                                        <div class="col-4">
                                            <div class="h2 mb-0">{{ avgDuration is not null ? avgDuration ~ ' s' : '-' }}</div>
                                            <div class="text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_time'|trans }}</div>
                                        </div>
                                        <div class="col-4">
                                            <div class="h2 mb-0">{{ minDuration is not null ? minDuration ~ ' s' : '-' }}</div>
                                            <div class="text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_min_time'|trans }}</div>
                                        </div>
                                        <div class="col-4">
                                            <div class="h2 mb-0">{{ maxDuration is not null ? maxDuration ~ ' s' : '-' }}</div>
                                            <div class="text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_max_time'|trans }}</div>
                                        </div>
                                    </div>
                                    <div style="height: 280px;"><canvas id="durationChart"></canvas></div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <div class="col-md-4">
                        <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_workflow_index') }}" class="btn btn-outline-primary w-100 btn-lg">
                            {{ ux_icon('tabler:topology-star-3') }} {{ 'bout_de_code_sylius_etl_plugin.ui.workflows'|trans }}
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_pipeline_index') }}" class="btn btn-outline-primary w-100 btn-lg">
                            {{ ux_icon('tabler:list-check') }} {{ 'bout_de_code_sylius_etl_plugin.ui.pipelines'|trans }}
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_planned_task_index') }}" class="btn btn-outline-primary w-100 btn-lg">
                            {{ ux_icon('tabler:calendar') }} {{ 'bout_de_code_sylius_etl_plugin.ui.planned_tasks'|trans }}
                        </a>
                    </div>

                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.latest_workflows'|trans }}</h3>
                            </div>
                            {% if latestWorkflows|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table">
                                        <thead>
                                            <tr>
                                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.name'|trans }}</th>
                                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.created_at'|trans }}</th>
                                                <th class="w-1"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for workflow in latestWorkflows %}
                                                <tr>
                                                    <td><strong>{{ workflow.name }}</strong></td>
                                                    <td class="text-secondary">{{ workflow.createdAt|date('d/m/Y') }}</td>
                                                    <td>
                                                        <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_workflow_show', {'id': workflow.id}) }}" class="btn btn-sm">
                                                            {{ ux_icon('tabler:eye') }} {{ 'bout_de_code_sylius_etl_plugin.action.show'|trans }}
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="card-body text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.no_results'|trans }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">{{ 'bout_de_code_sylius_etl_plugin.ui.latest_planned_tasks'|trans }}</h3>
                            </div>
                            {% if latestPlannedTasks|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table">
                                        <thead>
                                            <tr>
                                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.name'|trans }}</th>
                                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.enabled'|trans }}</th>
                                                <th>{{ 'bout_de_code_sylius_etl_plugin.grid.created_at'|trans }}</th>
                                                <th class="w-1"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for task in latestPlannedTasks %}
                                                <tr>
                                                    <td><strong>{{ task.name }}</strong></td>
                                                    <td>{% include '@BoutDeCodeSyliusETLPlugin/admin/grid/field/enabled.html.twig' with { data: task.enabled } %}</td>
                                                    <td class="text-secondary">{{ task.createdAt|date('d/m/Y') }}</td>
                                                    <td>
                                                        <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_planned_task_show', {'id': task.id}) }}" class="btn btn-sm">
                                                            {{ ux_icon('tabler:eye') }} {{ 'bout_de_code_sylius_etl_plugin.action.show'|trans }}
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="card-body text-secondary">{{ 'bout_de_code_sylius_etl_plugin.ui.no_results'|trans }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(function () {
    const successColor = '#2fb344';
    const failureColor = '#d63939';
    const durationColor = '#4299e1';
    const labelCompleted = {{ 'bout_de_code_sylius_etl_plugin.pipeline.status.completed'|trans|json_encode|raw }};
    const labelFailed = {{ 'bout_de_code_sylius_etl_plugin.pipeline.status.failed'|trans|json_encode|raw }};
    const labelAvgDuration = {{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_duration_workflow'|trans|json_encode|raw }};

    const allHistories = {{ historiesPerDay|json_encode|raw }};
    const periodDays = { '2weeks': 14, 'month': 30, 'year': 365 };

    function cutoffDate(days) {
        const d = new Date();
        d.setDate(d.getDate() - days);
        return d.toISOString().slice(0, 10);
    }

    function filterHistories(days) {
        if (!days) return allHistories;
        const cutoff = cutoffDate(days);
        return allHistories.filter(r => r.day >= cutoff);
    }

    function buildDayData(histories) {
        const days = [...new Set(histories.map(r => r.day))].sort();
        return {
            labels: days,
            success: days.map(d => histories.filter(r => r.day === d && r.status === 'completed').reduce((s, r) => s + r.count, 0)),
            failure: days.map(d => histories.filter(r => r.day === d && r.status === 'failed').reduce((s, r) => s + r.count, 0)),
        };
    }

    // --- Avg duration per workflow (global, PipelineStatistic aggregated by workflow) ---
    const allWorkflows = {{ byWorkflow|json_encode|raw }};
    const durationCtx = document.getElementById('durationChart');
    if (durationCtx) {
        new Chart(durationCtx, {
            type: 'bar',
            data: {
                labels: allWorkflows.map(w => w.name),
                datasets: [{
                    label: labelAvgDuration,
                    data: allWorkflows.map(w => w.avgDuration),
                    backgroundColor: durationColor + 'bb',
                    borderColor: durationColor,
                    borderWidth: 1,
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, title: { display: true, text: 's' } } },
            },
        });
    }

    // --- Vertical stacked bar by day (period-filtered) ---
    const barCtx = document.getElementById('barChart');
    let barChart = null;
    if (barCtx) {
        const initial = buildDayData(filterHistories(periodDays['year']));
        barChart = new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: initial.labels,
                datasets: [
                    { label: labelCompleted, data: initial.success, backgroundColor: successColor },
                    { label: labelFailed, data: initial.failure, backgroundColor: failureColor },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                scales: {
                    x: { stacked: false },
                    y: { beginAtZero: true, stacked: false },
                },
            },
        });
    }

    function updateChart(days) {
        if (!barChart) return;
        const data = buildDayData(filterHistories(days));
        barChart.data.labels = data.labels;
        barChart.data.datasets[0].data = data.success;
        barChart.data.datasets[1].data = data.failure;
        barChart.update();
    }

    document.querySelectorAll('[data-period]').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('[data-period]').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            updateChart(periodDays[this.dataset.period]);
        });
    });

    // Initialize with year filter
    updateChart(periodDays['year']);
})();
</script>
{% endblock %}

{% extends '@SyliusAdmin/layout.html.twig' %}

{% import '@SyliusUi/Macro/headers.html.twig' as headers %}

{% block title %}{{ 'bout_de_code_sylius_etl_plugin.ui.dashboard'|trans }} {{ parent() }}{% endblock %}

{% block content %}
{% set totalCount = totalSuccess + totalFailure %}

<div class="ui stackable grid">
    <div class="sixteen wide column">
        {{ headers.default(
            'bout_de_code_sylius_etl_plugin.ui.dashboard'|trans,
            'chart bar',
            'bout_de_code_sylius_etl_plugin.ui.dashboard_subtitle'|trans
        ) }}
    </div>
</div>

<div class="ui grid">
    <div class="column">
        <div class="stats">
            <div class="ui top attached action header">
                {{ 'bout_de_code_sylius_etl_plugin.ui.stat_summary'|trans }}
                <div class="ui buttons">
                    <button class="ui basic button" data-period="2weeks">
                        {{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_2weeks'|trans }}
                    </button>
                    <button class="ui basic button" data-period="month">
                        {{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_month'|trans }}
                    </button>
                    <button class="ui basic button active" data-period="year">
                        {{ 'bout_de_code_sylius_etl_plugin.ui.stat_period_year'|trans }}
                    </button>
                </div>
            </div>
            <div class="ui attached segment spaceless">
                <div class="stats-grid">
                    <div class="stats-column">
                        <div class="ui tiny statistic">
                            <div id="stat-total" class="value">{{ totalCount }}</div>
                            <div class="label">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_total'|trans }}</div>
                        </div>
                    </div>
                    <div class="stats-column">
                        <div class="ui green tiny statistic">
                            <div id="stat-success" class="value">{{ totalSuccess }}</div>
                            <div class="label">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_success'|trans }}</div>
                        </div>
                    </div>
                    <div class="stats-column">
                        <div class="ui red tiny statistic">
                            <div id="stat-failure" class="value">{{ totalFailure }}</div>
                            <div class="label">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_failure'|trans }}</div>
                        </div>
                    </div>
                    <div class="stats-column">
                        <div class="ui tiny statistic">
                            <div id="stat-rate" class="value">
                                {{ totalCount > 0 ? ((totalSuccess / totalCount) * 100)|round(1) : 0 }}%
                            </div>
                            <div class="label">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_success_rate'|trans }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="ui bottom attached segment stats-graph" style="min-height: 300px;">
                <canvas id="barChart"></canvas>
            </div>
            <div class="ui inverted dimmer stats-loader">
                <div class="ui loader"></div>
            </div>
        </div>
    </div>
</div>

{% if byWorkflow|length > 0 %}
<div class="ui grid">
    <div class="column">
        <div class="stats">
            <h3 class="ui top attached header">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_duration_workflow'|trans }}</h3>
            <div class="ui attached segment spaceless">
                <div class="stats-grid">
                    <div class="stats-column">
                        <div class="ui tiny statistic">
                            <div class="value" style="padding-bottom: 10px;">{{ avgDuration is not null ? avgDuration ~ ' s' : '-' }}</div>
                            <div class="label">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_time'|trans }}</div>
                        </div>
                    </div>
                    <div class="stats-column">
                        <div class="ui tiny statistic">
                            <div class="value" style="padding-bottom: 10px;">{{ minDuration is not null ? minDuration ~ ' s' : '-' }}</div>
                            <div class="label">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_min_time'|trans }}</div>
                        </div>
                    </div>
                    <div class="stats-column">
                        <div class="ui tiny statistic">
                            <div class="value" style="padding-bottom: 10px;">{{ maxDuration is not null ? maxDuration ~ ' s' : '-' }}</div>
                            <div class="label">{{ 'bout_de_code_sylius_etl_plugin.ui.stat_max_time'|trans }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="ui bottom attached segment" style="height: 280px;">
                <canvas id="durationChart"></canvas>
            </div>
        </div>
    </div>
</div>
{% endif %}

<div class="ui grid">
    <div class="center aligned doubling three column row">
        <div class="column">
            <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_workflow_index') }}" class="ui basic big fluid button">
                <i class="sitemap icon"></i>
                {{ 'bout_de_code_sylius_etl_plugin.ui.workflows'|trans }}
            </a>
        </div>
        <div class="column">
            <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_pipeline_index') }}" class="ui basic big fluid button">
                <i class="tasks icon"></i>
                {{ 'bout_de_code_sylius_etl_plugin.ui.pipelines'|trans }}
            </a>
        </div>
        <div class="column">
            <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_planned_task_index') }}" class="ui basic big fluid button">
                <i class="calendar alternate outline icon"></i>
                {{ 'bout_de_code_sylius_etl_plugin.ui.planned_tasks'|trans }}
            </a>
        </div>
    </div>
</div>

<div class="ui two column stackable grid">
    <div class="column">
        <h3 class="ui top attached header">{{ 'bout_de_code_sylius_etl_plugin.ui.latest_workflows'|trans }}</h3>
        <div class="ui attached segment">
            {% if latestWorkflows|length > 0 %}
            <table class="ui stackable very basic table">
                <thead>
                    <tr>
                        <th style="color: #ababab;">{{ 'bout_de_code_sylius_etl_plugin.grid.name'|trans }}</th>
                        <th style="color: #ababab;">{{ 'bout_de_code_sylius_etl_plugin.grid.created_at'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for workflow in latestWorkflows %}
                    <tr>
                        <td><strong>{{ workflow.name }}</strong></td>
                        <td style="color: #ababab;">{{ workflow.createdAt|date('d/m/Y') }}</td>
                        <td>
                            <div class="ui right floated buttons">
                                <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_workflow_show', {'id': workflow.id}) }}" class="ui labeled icon button">
                                    <i class="search icon"></i>
                                    {{ 'bout_de_code_sylius_etl_plugin.action.show'|trans }}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p class="ui disabled text">{{ 'bout_de_code_sylius_etl_plugin.ui.no_results'|trans }}</p>
            {% endif %}
        </div>
    </div>

    <div class="column">
        <h3 class="ui top attached header">{{ 'bout_de_code_sylius_etl_plugin.ui.latest_planned_tasks'|trans }}</h3>
        <div class="ui attached segment">
            {% if latestPlannedTasks|length > 0 %}
            <table class="ui stackable very basic table">
                <thead>
                    <tr>
                        <th style="color: #ababab;">{{ 'bout_de_code_sylius_etl_plugin.grid.name'|trans }}</th>
                        <th style="color: #ababab;">{{ 'bout_de_code_sylius_etl_plugin.grid.enabled'|trans }}</th>
                        <th style="color: #ababab;">{{ 'bout_de_code_sylius_etl_plugin.grid.created_at'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for task in latestPlannedTasks %}
                    <tr>
                        <td><strong>{{ task.name }}</strong></td>
                        <td>
                            {% if task.enabled %}
                                <span class="ui green label">{{ 'bout_de_code_sylius_etl_plugin.ui.enabled.true'|trans }}</span>
                            {% else %}
                                <span class="ui grey label">{{ 'bout_de_code_sylius_etl_plugin.ui.enabled.false'|trans }}</span>
                            {% endif %}
                        </td>
                        <td style="color: #ababab;">{{ task.createdAt|date('d/m/Y') }}</td>
                        <td>
                            <div class="ui right floated buttons">
                                <a href="{{ path('bout_de_code_sylius_etl_plugin_admin_planned_task_show', {'id': task.id}) }}" class="ui labeled icon button">
                                    <i class="search icon"></i>
                                    {{ 'bout_de_code_sylius_etl_plugin.action.show'|trans }}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p class="ui disabled text">{{ 'bout_de_code_sylius_etl_plugin.ui.no_results'|trans }}</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
    const successColor = '#21ba45';
    const failureColor = '#db2828';
    const durationColor = '#2185d0';
    const labelCompleted = {{ 'bout_de_code_sylius_etl_plugin.pipeline.status.completed'|trans|json_encode|raw }};
    const labelFailed = {{ 'bout_de_code_sylius_etl_plugin.pipeline.status.failed'|trans|json_encode|raw }};
    const labelAvgDuration = {{ 'bout_de_code_sylius_etl_plugin.ui.stat_avg_duration_workflow'|trans|json_encode|raw }};

    const allHistories = {{ historiesPerDay|json_encode|raw }};
    const periodDays = { '2weeks': 14, 'month': 30, 'year': 365 };

    function cutoffDate(days) {
        const d = new Date();
        d.setDate(d.getDate() - days);
        return d.toISOString().slice(0, 10);
    }

    function filterHistories(days) {
        if (!days) return allHistories;
        const cutoff = cutoffDate(days);
        return allHistories.filter(r => r.day >= cutoff);
    }

    function buildDayData(histories) {
        const days = [...new Set(histories.map(r => r.day))].sort();
        return {
            labels: days,
            success: days.map(d => histories.filter(r => r.day === d && r.status === 'completed').reduce((s, r) => s + r.count, 0)),
            failure: days.map(d => histories.filter(r => r.day === d && r.status === 'failed').reduce((s, r) => s + r.count, 0)),
        };
    }

    // --- Avg duration per workflow (global, PipelineStatistic aggregated by workflow) ---
    const allWorkflows = {{ byWorkflow|json_encode|raw }};
    const durationCtx = document.getElementById('durationChart');
    if (durationCtx) {
        new Chart(durationCtx, {
            type: 'bar',
            data: {
                labels: allWorkflows.map(w => w.name),
                datasets: [{
                    label: labelAvgDuration,
                    data: allWorkflows.map(w => w.avgDuration),
                    backgroundColor: durationColor + 'bb',
                    borderColor: durationColor,
                    borderWidth: 1,
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, title: { display: true, text: 's' } } },
            },
        });
    }

    // --- Vertical stacked bar by day (period-filtered) ---
    const barCtx = document.getElementById('barChart');
    let barChart = null;
    if (barCtx) {
        const initial = buildDayData(filterHistories(periodDays['year']));
        barChart = new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: initial.labels,
                datasets: [
                    { label: labelCompleted, data: initial.success, backgroundColor: successColor },
                    { label: labelFailed, data: initial.failure, backgroundColor: failureColor },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                scales: {
                    x: { stacked: false },
                    y: { beginAtZero: true, stacked: false },
                },
            },
        });
    }

    function updateChart(days) {
        if (!barChart) return;
        const data = buildDayData(filterHistories(days));
        barChart.data.labels = data.labels;
        barChart.data.datasets[0].data = data.success;
        barChart.data.datasets[1].data = data.failure;
        barChart.update();
    }

    document.querySelectorAll('[data-period]').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('[data-period]').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            updateChart(periodDays[this.dataset.period]);
        });
    });

    // Initialize with year filter
    updateChart(periodDays['year']);
})();
</script>
{% endblock %}
